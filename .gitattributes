# Byte-sealed rollout artifacts must use LF on every platform.
/docs/rollouts/** text eol=lf

# Byte-sealed verified JSON must use LF on every platform.
/data/verified/**/*.json text eol=lf

# Deterministic retailer configuration and approval manifests must use LF.
/config/retailers/** text eol=lf

# Immutable feed evidence and database migration contracts must use LF.
/data/feeds/**/*.csv text eol=lf
/supabase/migrations/**/*.sql text eol=lf
/supabase/rollbacks/**/*.sql text eol=lf

# Tracked sealed review fixtures under tmp must use LF.
/tmp/**/*.json text eol=lf

# GitHub workflow definitions must use LF on every platform.
/.github/workflows/**/*.yml text eol=lf
/.github/workflows/**/*.yaml text eol=lf
