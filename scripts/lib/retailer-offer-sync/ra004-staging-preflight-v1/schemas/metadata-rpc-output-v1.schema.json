{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ra-004-staging-preflight-metadata-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "q2_retailer", "q3_migration_ledger", "q4_objects", "q5_functions", "q6_roles", "q7_acl_rls", "snapshot", "metadata_fingerprint"],
  "properties": {
    "schema_version": {"const": "ra-004-staging-preflight-metadata-v1"},
    "q2_retailer": {"type": "object", "additionalProperties": false, "required": ["id", "name", "slug", "match_count"], "properties": {
      "id": {"type": "string", "minLength": 1, "maxLength": 64}, "name": {"const": "10 Reps"}, "slug": {"const": "10-reps"}, "match_count": {"const": 1}
    }},
    "q3_migration_ledger": {"type": "object", "additionalProperties": false, "required": ["target_version", "target_name", "target_match_count", "ordered_ledger_count", "ordered_ledger_fingerprint"], "properties": {
      "target_version": {"const": "20260924100000"}, "target_name": {"const": "add_transactional_retailer_control_state_interface"}, "target_match_count": {"const": 1},
      "ordered_ledger_count": {"type": "integer", "minimum": 1, "maximum": 10000}, "ordered_ledger_fingerprint": {"$ref": "#/$defs/sha256"}
    }},
    "q4_objects": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["object_schema", "object_name", "object_kind", "exists", "expected_state"], "properties": {
      "object_schema": {"$ref": "#/$defs/db_name"}, "object_name": {"type": "string", "minLength": 1, "maxLength": 128}, "object_kind": {"enum": ["TABLE", "FUNCTION"]}, "exists": {"const": true}, "expected_state": {"const": "PRESENT"}
    }}},
    "q5_functions": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["schema", "signature", "owner", "security_definer", "volatility", "search_path", "definition_sha256"], "properties": {
      "schema": {"const": "public"}, "signature": {"type": "string", "minLength": 1, "maxLength": 512}, "owner": {"$ref": "#/$defs/db_name"}, "security_definer": {"const": true}, "volatility": {"enum": ["s", "v"]},
      "search_path": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "search_path=pg_catalog"}}, "definition_sha256": {"$ref": "#/$defs/sha256"}
    }}},
    "q6_roles": {"type": "array", "minItems": 3, "maxItems": 24, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["role_name", "rolsuper", "rolinherit", "rolcreaterole", "rolcreatedb", "rolcanlogin", "rolreplication", "rolbypassrls", "membership_role", "set_option", "admin_option"], "properties": {
      "role_name": {"$ref": "#/$defs/db_name"}, "rolsuper": {"type": "boolean"}, "rolinherit": {"type": "boolean"}, "rolcreaterole": {"type": "boolean"}, "rolcreatedb": {"type": "boolean"}, "rolcanlogin": {"type": "boolean"}, "rolreplication": {"type": "boolean"}, "rolbypassrls": {"type": "boolean"},
      "membership_role": {"oneOf": [{"$ref": "#/$defs/db_name"}, {"type": "null"}]}, "set_option": {"type": ["boolean", "null"]}, "admin_option": {"type": ["boolean", "null"]}
    }}},
    "q7_acl_rls": {"type": "array", "minItems": 7, "maxItems": 64, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["object_schema", "object_name", "owner", "rls_enabled", "rls_forced", "policy_name", "policy_command", "policy_roles", "policy_using", "policy_with_check", "grantee", "privilege_type"], "properties": {
      "object_schema": {"$ref": "#/$defs/db_name"}, "object_name": {"type": "string", "minLength": 1, "maxLength": 128}, "owner": {"$ref": "#/$defs/db_name"}, "rls_enabled": {"type": "boolean"}, "rls_forced": {"type": "boolean"},
      "policy_name": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"type": "null"}]}, "policy_command": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 1}, {"type": "null"}]},
      "policy_roles": {"oneOf": [{"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/db_name"}}, {"type": "null"}]},
      "policy_using": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]}, "policy_with_check": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 512}, {"type": "null"}]},
      "grantee": {"oneOf": [{"$ref": "#/$defs/db_name"}, {"type": "null"}]}, "privilege_type": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 16}, {"type": "null"}]}
    }}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["isolation", "metadata_only", "retailer_rows_read", "business_rows_read"], "properties": {
      "isolation": {"const": "ONE_POSTGRESQL_STATEMENT"}, "metadata_only": {"const": true}, "retailer_rows_read": {"const": 1}, "business_rows_read": {"const": 0}
    }},
    "metadata_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "db_name": {"type": "string", "minLength": 1, "maxLength": 63}
  }
}
