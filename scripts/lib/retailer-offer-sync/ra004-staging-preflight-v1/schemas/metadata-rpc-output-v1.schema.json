{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ra-004-staging-preflight-metadata-v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "q2_retailer", "q3_migration_ledger", "q4_objects", "q5_functions", "q6_roles", "q7_acl_rls", "snapshot", "metadata_fingerprint"],
  "properties": {
    "schema_version": {"const": "ra-004-staging-preflight-metadata-v1"},
    "q2_retailer": {"type": "object", "additionalProperties": false, "required": ["id", "name", "slug", "match_count"], "properties": {"id": {"type": "string"}, "name": {"const": "10 Reps"}, "slug": {"const": "10-reps"}, "match_count": {"const": 1}}},
    "q3_migration_ledger": {"type": "object", "additionalProperties": false, "required": ["target_version", "target_name", "target_match_count", "ordered_ledger_count", "ordered_ledger_fingerprint"], "properties": {"target_version": {"const": "20260924100000"}, "target_name": {"const": "add_transactional_retailer_control_state_interface"}, "target_match_count": {"const": 1}, "ordered_ledger_count": {"type": "integer"}, "ordered_ledger_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "q4_objects": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["object_schema", "object_name", "object_kind", "exists", "expected_state"], "properties": {"object_schema": {"type": "string"}, "object_name": {"type": "string"}, "object_kind": {"enum": ["TABLE", "FUNCTION"]}, "exists": {"const": true}, "expected_state": {"const": "PRESENT"}}}},
    "q5_functions": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["schema", "signature", "owner", "security_definer", "volatility", "search_path", "definition_sha256"], "properties": {"schema": {"const": "public"}, "signature": {"type": "string"}, "owner": {"type": "string"}, "security_definer": {"const": true}, "volatility": {"enum": ["s", "v"]}, "search_path": {"type": "array", "items": {"type": "string"}}, "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "q6_roles": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["role_name", "rolsuper", "rolinherit", "rolcreaterole", "rolcreatedb", "rolcanlogin", "rolreplication", "rolbypassrls", "membership_role", "set_option", "admin_option"], "properties": {"role_name": {"type": "string"}, "rolsuper": {"type": "boolean"}, "rolinherit": {"type": "boolean"}, "rolcreaterole": {"type": "boolean"}, "rolcreatedb": {"type": "boolean"}, "rolcanlogin": {"type": "boolean"}, "rolreplication": {"type": "boolean"}, "rolbypassrls": {"type": "boolean"}, "membership_role": {"type": ["string", "null"]}, "set_option": {"type": ["boolean", "null"]}, "admin_option": {"type": ["boolean", "null"]}}}},
    "q7_acl_rls": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["object_schema", "object_name", "owner", "rls_enabled", "rls_forced", "policy_name", "policy_command", "policy_roles", "grantee", "privilege_type"], "properties": {"object_schema": {"type": "string"}, "object_name": {"type": "string"}, "owner": {"type": "string"}, "rls_enabled": {"type": "boolean"}, "rls_forced": {"type": "boolean"}, "policy_name": {"type": ["string", "null"]}, "policy_command": {"type": ["string", "null"]}, "policy_roles": {"type": ["array", "null"], "items": {"type": "string"}}, "grantee": {"type": ["string", "null"]}, "privilege_type": {"type": ["string", "null"]}}}},
    "snapshot": {"type": "object", "additionalProperties": false, "required": ["isolation", "metadata_only", "retailer_rows_read", "business_rows_read"], "properties": {"isolation": {"const": "ONE_POSTGRESQL_STATEMENT"}, "metadata_only": {"const": true}, "retailer_rows_read": {"const": 1}, "business_rows_read": {"const": 0}}},
    "metadata_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
